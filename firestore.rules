rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all unauthenticated/unmatched access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'invcorporation7@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'plan', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'plan', 'spectraUrl', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.plan is string && data.plan in ['basic', 'pro', 'admin']
        && (!('spectraUrl' in data) || (data.spectraUrl is string && data.spectraUrl.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserNote(data, userId) {
      return data.keys().hasAll(['ownerId', 'title', 'sectionName', 'pageCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'sectionName', 'pageCount', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.sectionName is string && data.sectionName.size() >= 1 && data.sectionName.size() <= 80
        && data.pageCount is int && data.pageCount >= 1 && data.pageCount <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      // Prevent self-assigned privilege escalation: non-admins must initialize as 'basic'
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().plan == 'basic' || isAdmin());

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().plan == existing().plan
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'spectraUrl', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      match /notes/{noteId} {
        allow get: if isValidId(userId) && isValidId(noteId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(noteId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserNote(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(noteId)
          && isValidUserNote(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'sectionName', 'pageCount', 'updatedAt'])
            )
          );

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(noteId)
          && (isOwner(userId) || isAdmin());
      }
    }
  }
}
