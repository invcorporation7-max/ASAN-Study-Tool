# GEMINI_API_KEY: Optional, server-side only if Gemini AI features are added (NEVER prefix with VITE_).
GEMINI_API_KEY=""

# APP_URL: Live Render URL (e.g. https://asan-study-tool.onrender.com)
APP_URL="https://asan-study-tool.onrender.com"

# DATABASE_URL: Supabase PostgreSQL Session Pooler URI (IPv4-compatible for Render).
# Format: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave empty to fall back to local JSON store (.data/asan_store.json).
DATABASE_URL=""

# SESSION_SECRET: Secret key used to sign password-auth session tokens on the server.
# Generate with: openssl rand -hex 32
SESSION_SECRET="asan-study-tool-dev-secret-change-me"

# NODE_VERSION: Ensure Render uses Node >=22.18.0 (e.g. 22.22.0) for unflagged native `node server.ts` execution.
NODE_VERSION="22.22.0"

# Google Analytics 4 (GA4) Tracking & Admin/Super Reporting
# Measurement ID from GA4 Admin -> Data Streams (e.g. G-XXXXXXXXXX)
GA4_MEASUREMENT_ID=""
VITE_GA_MEASUREMENT_ID=""
# Numeric GA4 Property ID from GA4 Admin -> Property Settings (digits only)
GA4_PROPERTY_ID=""
# Google Cloud Service Account JSON (grant Viewer role in GA4 Property Access Management)
GA4_SERVICE_ACCOUNT_JSON=""

# Optional Firebase Web API Key override (keeps rotated browser key out of git commits)
VITE_FIREBASE_API_KEY=""
FIREBASE_WEB_API_KEY=""

# VITE_API_BASE_URL: Leave empty when Express serves the built Vite app from the same Render origin.
VITE_API_BASE_URL=""
